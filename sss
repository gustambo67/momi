  <script>
    /* =========================================================
       1. PÉTALOS Y DESTELLOS CÁLIDOS FLOTANDO EN EL FONDO
    ========================================================= */
    const canvas = document.getElementById('petals-canvas');
    const ctx = canvas.getContext('2d');
    let petals = [];

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    const palette = [
      'rgba(212, 155, 75, 0.35)',
      'rgba(184, 107, 82, 0.28)',
      'rgba(109, 130, 110, 0.28)',
      'rgba(235, 196, 145, 0.42)'
    ];

    for (let i = 0; i < 34; i++) {
      petals.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: Math.random() * 6 + 4,
        speedY: Math.random() * 0.7 + 0.3,
        speedX: Math.random() * 0.6 - 0.3,
        angle: Math.random() * Math.PI * 2,
        spin: Math.random() * 0.02 - 0.01,
        color: palette[Math.floor(Math.random() * palette.length)]
      });
    }

    function animatePetals() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      petals.forEach(p => {
        p.y += p.speedY;
        p.x += p.speedX + Math.sin(p.angle) * 0.3;
        p.angle += p.spin;

        if (p.y > canvas.height + 15) {
          p.y = -15;
          p.x = Math.random() * canvas.width;
        }
        if (p.x > canvas.width + 15) p.x = -15;
        if (p.x < -15) p.x = canvas.width + 15;

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.ellipse(0, 0, p.r, p.r * 0.58, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      });
      requestAnimationFrame(animatePetals);
    }
    animatePetals();

    /* =========================================================
       2. MELODÍA SUAVE DE VIOLÍN / CUERDAS (WEB AUDIO API)
    ========================================================= */
    let audioCtx = null;
    let isPlayingMusic = false;
    let melodyInterval = null;

    const notes = [261.63, 329.63, 392.00, 493.88, 440.00, 392.00, 329.63, 293.66];
    let noteIndex = 0;

    function playSoftNote(freq) {
      if (!audioCtx) return;
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      const filter = audioCtx.createBiquadFilter();

      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, now);

      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(850, now);

      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.065, now + 0.45);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.2);

      osc.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start(now);
      osc.stop(now + 2.3);
    }

    const musicBtn = document.getElementById('musicBtn');
    const musicText = document.getElementById('musicText');
    const musicIcon = document.getElementById('musicIcon');

    musicBtn.addEventListener('click', () => {
      if (!isPlayingMusic) {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') audioCtx.resume();

        isPlayingMusic = true;
        musicBtn.classList.add('playing');
        musicText.textContent = 'Pausar melodía';
        musicIcon.textContent = '🎶';

        playSoftNote(notes[noteIndex]);
        noteIndex = (noteIndex + 1) % notes.length;

        melodyInterval = setInterval(() => {
          playSoftNote(notes[noteIndex]);
          noteIndex = (noteIndex + 1) % notes.length;
        }, 1800);
      } else {
        isPlayingMusic = false;
        clearInterval(melodyInterval);
        musicBtn.classList.remove('playing');
        musicText.textContent = 'Escuchar melodía suave';
        musicIcon.textContent = '🎻';
      }
    });

    /* =========================================================
       3. SOBRE VIRTUAL, SELLOS DE CERA Y EDICIÓN DE CARTA
    ========================================================= */
    const envelopeClosed = document.getElementById('envelopeClosed');
    const letterPaper = document.getElementById('letterPaper');
    const waxSeal = document.getElementById('waxSeal');
    const sealBtns = document.querySelectorAll('.seal-btn');
    const closeEnvelopeBtn = document.getElementById('closeEnvelopeBtn');
    const toggleEditBtn = document.getElementById('toggleEditBtn');
    const letterText = document.getElementById('letterText');

    sealBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        sealBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        waxSeal.className = 'wax-seal ' + btn.dataset.seal;
        waxSeal.textContent = btn.dataset.icon;
      });
    });

    function openEnvelope() {
      envelopeClosed.style.display = 'none';
      letterPaper.classList.add('open');
    }

    envelopeClosed.addEventListener('click', openEnvelope);
    envelopeClosed.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') openEnvelope();
    });

    closeEnvelopeBtn.addEventListener('click', () => {
      letterPaper.classList.remove('open');
      envelopeClosed.style.display = 'block';
    });

    toggleEditBtn.addEventListener('click', () => {
      const isEditable = letterText.getAttribute('contenteditable') === 'true';
      if (!isEditable) {
        letterText.setAttribute('contenteditable', 'true');
        letterText.focus();
        toggleEditBtn.textContent = '✅ Guardar cambios';
      } else {
        letterText.setAttribute('contenteditable', 'false');
        toggleEditBtn.textContent = '✏️ Editar mensaje';
      }
    });

    /* =========================================================
       4. VIDEO INTERACTIVO (SOLO INICIA AL HACER CLIC)
    ========================================================= */
    const momiVideo = document.getElementById('momiVideo');
    const videoOverlay = document.getElementById('videoOverlay');

    momiVideo.pause();
    momiVideo.autoplay = false;

    videoOverlay.addEventListener('click', () => {
      videoOverlay.classList.add('hidden');
      if (isPlayingMusic) {
        musicBtn.click();
      }
      momiVideo.play();
    });

    momiVideo.addEventListener('ended', () => {
      videoOverlay.classList.remove('hidden');
    });

    /* =========================================================
       5. MARCOS BOTÁNICOS Y VISOR DE GALERÍA FIJA
    ========================================================= */
    const frameBtns = document.querySelectorAll('.frame-btn');
    const photoCards = document.querySelectorAll('.photo-frame-card');
    const frameClasses = ['frame-olive', 'frame-marigold', 'frame-terracotta-bloom', 'frame-vintage-gold'];

    frameBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        frameBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const selectedFrame = btn.dataset.frame;

        photoCards.forEach(card => {
          card.classList.remove(...frameClasses);
          card.classList.add(selectedFrame);
        });
      });
    });

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxCaption = document.getElementById('lightboxCaption');
    const lightboxClose = document.getElementById('lightboxClose');

    photoCards.forEach(card => {
      card.addEventListener('click', () => {
        const img = card.querySelector('img');
        lightboxImg.src = img.src;
        lightboxCaption.textContent = card.dataset.caption;
        lightbox.classList.add('active');
      });
    });

    lightboxClose.addEventListener('click', () => lightbox.classList.remove('active'));
    lightbox.addEventListener('click', e => {
      if (e.target === lightbox) lightbox.classList.remove('active');
    });

    /* =========================================================
       6. CUENTA REGRESIVA
    ========================================================= */
    const specialDateInput = document.getElementById('specialDate');
    const defaultTarget = new Date();
    defaultTarget.setDate(defaultTarget.getDate() + 30);
    specialDateInput.value = defaultTarget.toISOString().split('T')[0];

    function updateCountdown() {
      const targetStr = specialDateInput.value;
      if (!targetStr) return;

      const targetDate = new Date(targetStr + 'T00:00:00');
      const now = new Date();
      const diff = targetDate - now;

      if (diff <= 0) {
        document.getElementById('cdDays').textContent = '00';
        document.getElementById('cdHours').textContent = '00';
        document.getElementById('cdMins').textContent = '00';
        document.getElementById('cdSecs').textContent = '00';
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const mins = Math.floor((diff / (1000 * 60)) % 60);
      const secs = Math.floor((diff / 1000) % 60);

      document.getElementById('cdDays').textContent = String(days).padStart(2, '0');
      document.getElementById('cdHours').textContent = String(hours).padStart(2, '0');
      document.getElementById('cdMins').textContent = String(mins).padStart(2, '0');
      document.getElementById('cdSecs').textContent = String(secs).padStart(2, '0');
    }

    specialDateInput.addEventListener('change', updateCountdown);
    setInterval(updateCountdown, 1000);
    updateCountdown();
  </script>
